#Political Parties that are listed on Wikipedia

SELECT ?wdPlain ?label_en ?short ?display
WHERE {
  ?party wdt:P31/wdt:P279* wd:Q7278.
  ?party wdt:P17 wd:Q258.

  OPTIONAL {
    ?party wdt:P1813 ?short.
  }

  ?party rdfs:label ?label_en.
  FILTER (lang(?label_en) = "en")

  BIND(REPLACE(STR(?party),
    "http://www.wikidata.org/entity/", "") AS ?wdPlain)

  BIND(COALESCE(?short, ?label_en) AS ?display)
}
ORDER BY ?label_en
