#defaultView:Map
SELECT DISTINCT ?item ?name ?coord ?lat ?lon
WHERE {
   hint:Query hint:optimizer "None" .
   ?item wdt:P131* wd:Q2346838.#Tray Located in the administrative territory - Johannesburg
   ?item wdt:P31/wdt:P279* wd:Q7075. #Instance (or sublass )of a - library
   ?item wdt:P625 ?coord .
   ?item p:P625 ?coordinate .
   ?coordinate psv:P625 ?coordinate_node .
   ?coordinate_node wikibase:geoLatitude ?lat .
   ?coordinate_node wikibase:geoLongitude ?lon .
   SERVICE wikibase:label {
    bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" .
    ?item rdfs:label ?name
   }
}
ORDER BY ASC (?name)
#Adapted from all museums in Barcelona with coordinates
