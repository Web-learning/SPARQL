SELECT DISTINCT 
       ?district
       ?districtLabel
?province
?provinceLabel
       ?coordinates
       ?geojson


WHERE {
  ?district wdt:P31 wd:Q1589568 ;
            wdt:P17 wd:Q258 .

  OPTIONAL {
    ?district wdt:P625 ?coordinates .
  }
  
    OPTIONAL {
    ?district wdt:P3896 ?geojson .
  }

  OPTIONAL {
    ?district wdt:P18 ?img .
  }
  
    OPTIONAL {
    ?district wdt:P131 ?province .
  }

  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en".
  }
}
