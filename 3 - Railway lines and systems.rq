# ----------------------------
# SPARQL for railway lines and their systems
# ----------------------------

# South African railway lines in pages of 50
SELECT DISTINCT ?line ?lineLabel ?coord ?geoJSON ?systemLabel WHERE {
  ?line wdt:P31/wdt:P279* wd:Q728937 .
  ?line wdt:P17 wd:Q258 .
  OPTIONAL { ?line wdt:P625 ?coord }
  OPTIONAL { 
    ?line wdt:P3896 ?geo .
    ?geo wdt:P3895 ?geoJSON .
  }
  OPTIONAL { ?line wdt:P137 ?system } # owned by rail system (optional)
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
LIMIT 50 OFFSET 0
