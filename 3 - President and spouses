#President and their spouses

SELECT ?pres ?presLabel ?presPic ?spouse ?spouseLabel WHERE {
   ?pres wdt:P31 wd:Q5 .
   ?pres wdt:P39 wd:Q273884 .
   ?pres wdt:P26 ?spouse .
     SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en" .
   }
 }

