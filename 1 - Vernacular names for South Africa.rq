#On Wikipedia, what is the vernacular name given to the word South Africa (Q258)
#On Wikipedia, what is the vernacular name given to the word Johannesburg ((Q34647))
#On Wikipedia, what is the vernacular name given to the word Pietermaritzburg ((Q185591))

SELECT DISTINCT ?language ?vernacularName WHERE {
  ?article schema:about wd:Q185591. hint:Prior hint:runFirst true.
  ?article schema:inLanguage ?language ;
    schema:name ?vernacularName ;
    schema:isPartOf [ wikibase:wikiGroup "wikipedia" ] .
  FILTER(?language in ('en', 'af', 'nr', 'nso', 'ss', 'st', 'tn', 'ts', 've', 'xh', 'zu' )) .
  FILTER (!CONTAINS(?vernacularName, ':')) .
}
